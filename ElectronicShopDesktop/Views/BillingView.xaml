<UserControl x:Class="ElectronicShop.App.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Bill" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: customer/ticket + product search + cart -->
            <StackPanel Grid.Column="0">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Customer" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name" Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Link Service Ticket (optional)" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CustomerTickets}" SelectedItem="{Binding SelectedTicket}"
                                      DisplayMemberPath="DeviceDescription" Padding="10,8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Add Products" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBox Style="{StaticResource SearchBoxStyle}"
                                 Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search by name or SKU..." Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat='₹ {0:N0}'}"
                                                       Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="12,0"/>
                                            <Button Grid.Column="2" Content="+ Add" Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4" FontSize="11"
                                                    Command="{Binding DataContext.AddProductToCartCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,14"/>

                <TextBlock Text="Or add a part not in inventory" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource SearchBoxStyle}"
                         Text="{Binding CustomItemDescription, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Part description..."/>
                    <TextBox Grid.Column="2" Style="{StaticResource SearchBoxStyle}"
                         Text="{Binding CustomItemPrice, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Price"/>
                    <TextBox Grid.Column="4" Style="{StaticResource SearchBoxStyle}"
                         Text="{Binding CustomItemQuantity, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Qty"/>
                    <Button Grid.Column="6" Content="+ Add" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,8" Command="{Binding AddCustomItemCommand}"/>
                </Grid>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,14"/>


                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Cart" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Description, Mode=OneWay}"
                                                   Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SearchBoxStyle}" HorizontalContentAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='₹ {0:N0}', Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="10,0"/>

                                        <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat='₹ {0:N0}', Mode=OneWay}"
                                                   Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <Button Grid.Column="4" Content="✕" Style="{StaticResource QtyStepperButtonStyle}"
                                                Command="{Binding DataContext.RemoveFromCartCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: totals + save -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Bill Summary" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,12,0,8">
                        <TextBlock Text="Subtotal" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat='₹ {0:N0}', Mode=OneWay}"
                                   Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="Discount" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Tax" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding TaxAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Service Charge" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding ServiceCharge, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Payment Status" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding PaymentStatus}" Padding="10,8" Margin="0,0,0,14">
                        <ComboBoxItem Content="Paid"/>
                        <ComboBoxItem Content="Pending"/>
                    </ComboBox>

                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Total" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat='₹ {0:N0}', Mode=OneWay}"
                                   Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <Button Content="Save Bill" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveBillCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>