<Window x:Class="ElectronicShop.App.Views.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Customer" Height="420" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add Customer" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Name" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Phone" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Email (optional)" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Address (optional)" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="60" Margin="0,0,0,14"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
            <Button Content="Save Customer" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>