<Window x:Class="ElectronicShop.App.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ElectronicShop.App.Behaviors"
        Title="Add Product" Height="640" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Add Product" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Add a new part to your inventory" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Basic info -->
                <TextBlock Text="Product Name" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="SKU" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                <!-- Category section -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                <TextBlock Text="Category" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" Padding="10,8" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource SearchBoxStyle}"
                             Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Or type a new category..."/>
                    <Button Grid.Column="2" Content="+ Add" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8" Command="{Binding AddCategoryCommand}"/>
                </Grid>

                <!-- Pricing & stock section -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Unit Price (₹)" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource SearchBoxStyle}"
                                 behaviors:NumericInputBehavior.AllowDecimal="True"
                                 Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Opening Quantity" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource SearchBoxStyle}"
                                 behaviors:NumericInputBehavior.AllowDecimal="False"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Low Stock Threshold" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         behaviors:NumericInputBehavior.AllowDecimal="False"
                         Text="{Binding LowStockThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                <TextBlock Text="You'll be alerted when stock falls to or below this number"
                           Style="{StaticResource CaptionStyle}" FontSize="10" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" Padding="18,9" Margin="0,0,10,0"/>
                <Button Content="Save Product" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" Padding="18,9"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>