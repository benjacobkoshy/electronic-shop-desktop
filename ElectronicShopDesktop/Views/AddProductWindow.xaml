<Window x:Class="ElectronicShop.App.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Product" Height="700" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add Product" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Product Name" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="SKU" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Category" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
          DisplayMemberPath="Name" Margin="0,0,0,8" Padding="10,8"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource SearchBoxStyle}"
             Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
             Tag="Or type a new category..."/>
                <Button Grid.Column="2" Content="+ Add" Style="{StaticResource SecondaryButtonStyle}"
            Padding="12,8" Command="{Binding AddCategoryCommand}"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Unit Price (₹)" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Opening Quantity" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Low Stock Threshold" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding LowStockThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
            <Button Content="Save Product" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>