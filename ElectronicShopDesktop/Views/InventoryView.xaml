<UserControl x:Class="ElectronicShop.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Inventory" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Manage stock, pricing, and categories" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="+ Add Product" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddProductCommand}" Padding="18,10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="TOTAL PRODUCTS" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding TotalItems, Mode=OneWay}" Style="{StaticResource StatValueStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="LOW / OUT OF STOCK" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding LowStockCount, Mode=OneWay}" Style="{StaticResource StatValueStyle}"
                               Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="TOTAL STOCK VALUE" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding TotalStockValue, StringFormat='₹ {0:N0}', Mode=OneWay}"
                               Style="{StaticResource StatValueStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Search + category filter -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource SearchBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by name or SKU..."/>

            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}" GroupName="CategoryFilter"
                                         Style="{StaticResource CategoryChipStyle}"
                                         Command="{Binding DataContext.SelectCategoryCommand,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Stock table -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding ItemsView}"
                          Style="{StaticResource InventoryGridStyle}"
                          ColumnHeaderStyle="{StaticResource InventoryGridHeaderStyle}"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="False"
                          Visibility="{Binding TotalItems, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name, Mode=OneWay}" Width="2*" MinWidth="160"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku, Mode=OneWay}" Width="*" MinWidth="90"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category, Mode=OneWay}" Width="*" MinWidth="100"/>
                        <DataGridTextColumn Header="PRICE" Binding="{Binding UnitPrice, StringFormat='₹ {0:N0}', Mode=OneWay}" Width="*" MinWidth="80"/>

                        <DataGridTemplateColumn Header="QUANTITY" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="−" Style="{StaticResource QtyStepperButtonStyle}"
                                                Command="{Binding DataContext.DecreaseStockCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Quantity, Mode=OneWay}" Width="36" TextAlignment="Center"
                                                   VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}"/>
                                        <Button Content="+" Style="{StaticResource QtyStepperButtonStyle}"
                                                Command="{Binding DataContext.IncreaseStockCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="STATUS" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StockStatus, Converter={StaticResource StockStatusBrushConverter}}"
                                            CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StockStatus, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                            Padding="10,6" FontSize="11" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.DeleteProductCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding TotalItems, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="No products yet" Style="{StaticResource SectionHeaderStyle}"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Click &quot;+ Add Product&quot; to add your first item" Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>