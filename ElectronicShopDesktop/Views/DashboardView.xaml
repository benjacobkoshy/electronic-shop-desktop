<UserControl x:Class="ElectronicShop.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">

            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{Binding WelcomeMessage}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{Binding TodayDate}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Stat cards -->
            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                            <StackPanel>
                                <Border Style="{StaticResource StatIconBadgeStyle}"
                                        Background="{Binding AccentBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                        Opacity="0.15">
                                    <TextBlock Text="{Binding Icon}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource StatValueStyle}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabelStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Two-column content -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Recent bills -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent Bills" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsControl ItemsSource="{Binding RecentBills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding CustomerName}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource CaptionStyle}">
                                                <Run Text="{Binding BillNumber}"/>
                                                <Run Text=" • "/>
                                                <Run Text="{Binding Date, StringFormat=dd MMM}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='₹ {0:N0}'}"
                                                   Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="16,0"/>
                                        <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}"
                                                Background="{Binding Status, Converter={StaticResource BrushKeyConverter}, ConverterParameter=StatusToBrush}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextOnDarkBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right column: low stock + customer status -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Low Stock Alerts" Style="{StaticResource SectionHeaderStyle}"/>
                            <ItemsControl ItemsSource="{Binding LowStockAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" Style="{StaticResource BodyTextStyle}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}">
                                                    <Run Text="{Binding RemainingQty}"/>
                                                    <Run Text=" left"/>
                                                </TextBlock>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="{Binding ThresholdQty}"
                                                         Value="{Binding RemainingQty}" Height="4" Margin="0,6,0,0"
                                                         Foreground="{DynamicResource DangerBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Customer Status" Style="{StaticResource SectionHeaderStyle}"/>
                            <ItemsControl ItemsSource="{Binding CustomerStatusBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding BrushKey, Converter={StaticResource BrushKeyConverter}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource BodyTextStyle}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="Bold"
                                                       Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>