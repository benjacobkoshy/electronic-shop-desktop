<Window x:Class="ElectronicShop.App.Views.AddServiceTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Service Ticket" Height="360" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Service Ticket" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Device / Issue Description" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding DeviceDescription, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="60" Margin="0,0,0,14"/>

            <TextBlock Text="Notes (optional)" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="60" Margin="0,0,0,14"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
            <Button Content="Create Ticket" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>